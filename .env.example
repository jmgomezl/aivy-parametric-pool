# Hedera testnet operator (pays fees, acts as the pool agent)
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.xxxxxxx
HEDERA_OPERATOR_KEY=

# Oracle agent keys are generated by scripts/d1-bootstrap.js and written to
# .artifacts/ (gitignored). In production each oracle holds its own key and the
# pool never sees it.

