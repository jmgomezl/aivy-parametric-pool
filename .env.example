# Hedera testnet operator (pays fees, acts as the pool agent)
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.xxxxxxx
HEDERA_OPERATOR_KEY=
# DER | ECDSA | ED25519. A bare 32-byte hex key is ambiguous, so pin it here.
# Startup validates this against the mirror node and fails loudly on a mismatch.
HEDERA_OPERATOR_KEY_TYPE=ECDSA

# Provisioning creates demo oracle keys in .artifacts/ (gitignored).
# This prototype shares one host/admin trust domain; independent oracle custody
# is a production requirement, not a property of this deployment.

# Hosted Blocky402 on Hedera testnet is pinned in src/x402/blocky.js.
# No API key or local facilitator signing key is needed.

# Uniswap Trading API — cross-asset settlement quotes
UNISWAP_API_KEY=
EVM_CHAIN_ID=8453

# Rolling admission limits; nonnegative integers. Zero pauses new attempts.
# Persisted before ledger writes, including interrupted attempts.
LIMIT_PER_IP_HOUR=3
LIMIT_POLICIES_DAY=100
LIMIT_USD_DAY=20000
# Enable only behind the local trusted reverse proxy.
TRUST_PROXY=0

# Optional: read-only companion topic interpretation; never transaction authority.
OPENAI_API_KEY=
