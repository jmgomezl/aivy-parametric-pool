# Hedera testnet operator (pays fees, acts as the pool agent)
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.xxxxxxx
HEDERA_OPERATOR_KEY=
# DER | ECDSA | ED25519. A bare 32-byte hex key is ambiguous, so pin it here.
# Startup validates this against the mirror node and fails loudly on a mismatch.
HEDERA_OPERATOR_KEY_TYPE=ECDSA

# Oracle agent keys are generated by scripts/d1-bootstrap.js and written to
# .artifacts/ (gitignored). In production each oracle holds its own key and the
# pool never sees it.

# x402 facilitator (see research/x402-facilitator.md — mainnet only as of 2026-09-04)
X402_FACILITATOR_URL=https://api.blocky402.com
